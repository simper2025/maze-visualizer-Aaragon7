@page "/BasicMaze"
@using Microsoft.VisualBasic
@using System.Runtime.CompilerServices
@using labyrinth

<PageTitle>Basic Maze Visualizer</PageTitle>

<h1>Enter your name</h1>
<input @bind="userName" />
<button @onclick="generateMaze">Generate Basic Maze</button>

@code
{
    List<NodeLink> visited = new List<NodeLink>();
    string? userName;

    void generateMaze()
    {
        /* Change this constant to contain your name.
        *
        * WARNING: Once you've set set this constant and started exploring your maze,
        * do NOT edit the value of YourName. Changing YourName will change which
        * maze you get back, which might invalidate all your hard work!
        */
        string YOUR_NAME;
        if (userName != null) { YOUR_NAME = userName; }
        else { YOUR_NAME = ""; }

        /* Change these constants to contain the paths out of your mazes. */
        string PATH_OUT_OF_MAZE = "ESENEWSWNWSSESWENESEN";
        string PATH_OUT_OF_TWISTY_MAZE = "NNSSNWNW";

        MazeCell startLocation = MazeUtilities.mazeFor(YOUR_NAME);

        /* Set a breakpoint here to explore your maze! */

        if (MazeUtilities.isPathToFreedom(startLocation, PATH_OUT_OF_MAZE))
        {
            Console.WriteLine("Congratulations! You've found a way out of your labyrinth.");
        }
        else
        {
            Console.WriteLine("Sorry, but you're still stuck in your labyrinth.");
        }


        MazeCell twistyStartLocation = MazeUtilities.twistyMazeFor(YOUR_NAME);

        /* Set a breakpoint here to explore your twisty maze! */

        if (MazeUtilities.isPathToFreedom(twistyStartLocation, PATH_OUT_OF_TWISTY_MAZE))
        {
            Console.WriteLine("Congratulations! You've found a way out of your twisty labyrinth.");
        }
        else
        {
            Console.WriteLine("Sorry, but you're still stuck in your twisty labyrinth.");
        }


    }

    public record NodeLink(MazeCell From, string Direction, MazeCell To)
    {
        public string Label => $"{Direction} to {To.Id}";


        public List<NodeLink>? Recursion_ExploreMaze(MazeCell? startingCell, ref List<NodeLink> visited)
        {
            if (startingCell == null) { return null; }
            foreach (NodeLink node in visited)
            {
                // Once the list of NodeLinks has linked all the nodes in the maze connected to the initial starting cell
                if (visited.Any(n => n.From == node.To))
                { return visited; }
            }
            MazeCell? nextCell = null;
            if (ExploreNode(startingCell, ref visited) != null)
            { nextCell = ExploreNode(startingCell, ref visited); }
            //Recursion
            return Recursion_ExploreMaze(nextCell, ref visited);
        }
        private MazeCell? ExploreNode(MazeCell start, ref List<NodeLink> nodes)
        {
            if (start == null) { return null; }
            NodeLink? newNode = (
            start.North != null ?
            new NodeLink(start, "N", start.North) :
            start.East != null ?
            new NodeLink(start, "E", start.East) :
            start.South != null ?
            new NodeLink(start, "S", start.South) :
            start.West != null ?
            new NodeLink(start, "W", start.West) : null); // return null if no path

            if (newNode != null)
            {
                nodes.Add(newNode);
                return newNode.To;
            }
            return null;
            @*

        make new NodeLink from start going N to start.North
        if list of visited nodes does not contain new NodeLink
            add new NodeLink to list of visited nodes
            call exploreNode passing start.North *@

        }
    }
}